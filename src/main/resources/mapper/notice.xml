<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.foodsite.dao.NoticeDAO">

    <!-- 검색 조건과 페이징을 적용한 공지사항 목록 조회 -->
    <select id="selectList"
            resultType="notice">

        select *
        from notice

        <where>
            <!-- 검색어가 있을 때만 제목 검색 조건 추가 -->
            <if test="search_text != null and search_text != ''">
                title like concat('%', #{search_text}, '%')
            </if>
        </where>

        <!-- 최신 공지사항부터 출력 -->
        order by notice_id desc

        <!-- 현재 페이지에 해당하는 데이터만 조회 -->
        limit #{start}, #{pageSize}

    </select>

    <!-- 검색 조건에 해당하는 전체 공지사항 개수 조회 -->
    <select id="notice_count"
            resultType="int">

        select count(*)
        from notice

        <where>
            <if test="search_text != null and search_text != ''">
                title like concat('%', #{search_text}, '%')
            </if>
        </where>

    </select>

    <!-- 공지사항 번호로 상세 정보 조회 -->
    <select id="noticeView"
            parameterType="int"
            resultType="notice">

        select *
        from notice
        where notice_id = #{notice_id}

    </select>

    <!-- 공지사항 등록 후 생성된 notice_id를 VO에 자동 저장 -->
    <insert id="notice_insert"
            parameterType="notice"
            useGeneratedKeys="true"
            keyProperty="notice_id">

        insert into notice (
            member_id,
            title,
            content,
            view_count,
            created_date
        ) values (
            #{member_id},
            #{title},
            #{content},
            0,
            now()
        )

    </insert>

    <!-- 공지사항에 첨부된 이미지 목록 등록 -->
    <insert id="notice_img_insert"
            parameterType="img"
            useGeneratedKeys="true"
            keyProperty="img_id">

        insert into img (
            image_list,
            notice_id
        ) values (
            #{image_list},
            #{notice_id}
        )

    </insert>

    <!-- 공지사항 번호에 연결된 이미지 정보 조회 -->
    <select id="notice_img_select"
            parameterType="int"
            resultType="img">

        select *
        from img
        where notice_id = #{notice_id}
        limit 1

    </select>

    <!-- 공지사항 이미지 파일명 목록 수정 -->
    <update id="notice_img_update"
            parameterType="img">

        update img
        set image_list = #{image_list}
        where notice_id = #{notice_id}

    </update>

    <!-- 공지사항에 연결된 이미지 정보 삭제 -->
    <delete id="notice_img_delete"
            parameterType="int">

        delete from img
        where notice_id = #{notice_id}

    </delete>

    <!-- 공지사항 제목과 내용 수정 -->
    <update id="notice_update"
            parameterType="notice">

        update notice
        set
            title = #{title},
            content = #{content}
        where notice_id = #{notice_id}

    </update>

    <!-- 공지사항 삭제 -->
    <delete id="notice_delete"
            parameterType="int">

        delete from notice
        where notice_id = #{notice_id}

    </delete>

</mapper>